<mujoco model="disaster_response_drone_prototype">
  <compiler angle="degree" coordinate="local"/>
  <option gravity="0 0 0" timestep="0.0166667"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.12 0.18 0.25" width="512" height="512"/>
    <texture name="grid_tex" type="2d" builtin="checker" width="512" height="512" rgb1="0.22 0.25 0.28" rgb2="0.16 0.18 0.20"/>
    <material name="grid_mat" texture="grid_tex" texrepeat="125 125" reflectance="0.08" shininess="0.1"/>
    
    <!-- Drone Materials -->
    <material name="drone_chassis" rgba="0.12 0.12 0.14 1.0" specular="0.4" shininess="0.3"/>
    <material name="drone_arm" rgba="0.28 0.30 0.33 1.0" specular="0.3"/>
    <material name="rotor_front" rgba="0.95 0.25 0.15 0.9" specular="0.5"/>
    <material name="rotor_rear" rgba="0.15 0.65 0.95 0.9" specular="0.5"/>
    <material name="drone_indicator" rgba="0.2 0.9 0.3 1.0"/>
    <material name="comm_sphere_mat" rgba="0.2 0.55 1.0 0.12"/>
    <material name="comm_sphere_d2_mat" rgba="0.9 0.5 0.1 0.10"/>

    <!-- Building Materials -->
    <material name="building_facade1" rgba="0.42 0.45 0.50 1.0" specular="0.2"/>
    <material name="building_facade2" rgba="0.35 0.38 0.42 1.0" specular="0.2"/>
    <material name="building_facade3" rgba="0.48 0.50 0.54 1.0" specular="0.2"/>
    <material name="building_roof" rgba="0.25 0.27 0.30 1.0"/>
  </asset>

  <worldbody>
    <!-- Light source -->
    <light directional="true" pos="50 50 150" dir="-0.3 -0.3 -1.0" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3"/>
    <light directional="true" pos="-100 -100 120" dir="0.4 0.4 -0.8" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>

    <!-- Ground plane: 500m x 500m search area (half-extent 250m) -->
    <geom name="ground" type="plane" size="250 250 1" material="grid_mat"/>

    <!-- Visible 3D Coordinate Triad at Origin (0, 0, 0) -->
    <geom name="axis_origin" type="sphere" pos="0 0 0.1" size="0.6" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="axis_x" type="cylinder" fromto="0 0 0.1 20 0 0.1" size="0.35" rgba="0.95 0.15 0.15 1" contype="0" conaffinity="0"/>
    <geom name="axis_y" type="cylinder" fromto="0 0 0.1 0 20 0.1" size="0.35" rgba="0.15 0.85 0.2 1" contype="0" conaffinity="0"/>
    <geom name="axis_z" type="cylinder" fromto="0 0 0.1 0 0 20" size="0.35" rgba="0.2 0.4 0.95 1" contype="0" conaffinity="0"/>

    <!-- ==================== BUILDINGS / OBSTACLES ==================== -->
    <!-- Building_01: Pos (100, 100, 25), Size (80, 100, 50) -> half-extents (40, 50, 25) -->
    <body name="Building_01" pos="100 100 25">
      <geom name="bldg01_geom" type="box" size="40 50 25" material="building_facade1"/>
      <geom name="bldg01_roof" type="box" pos="0 0 25.1" size="39 49 0.1" material="building_roof" contype="0" conaffinity="0"/>
    </body>

    <!-- Building_02: Pos (-100, 150, 30), Size (120, 80, 60) -> half-extents (60, 40, 30) -->
    <body name="Building_02" pos="-100 150 30">
      <geom name="bldg02_geom" type="box" size="60 40 30" material="building_facade2"/>
      <geom name="bldg02_roof" type="box" pos="0 0 30.1" size="59 39 0.1" material="building_roof" contype="0" conaffinity="0"/>
    </body>

    <!-- Building_03: Pos (120, -120, 20), Size (70, 70, 40) -> half-extents (35, 35, 20) -->
    <body name="Building_03" pos="120 -120 20">
      <geom name="bldg03_geom" type="box" size="35 35 20" material="building_facade3"/>
      <geom name="bldg03_roof" type="box" pos="0 0 20.1" size="34 34 0.1" material="building_roof" contype="0" conaffinity="0"/>
    </body>

    <!-- Building_04: Pos (-130, -100, 35), Size (90, 60, 70) -> half-extents (45, 30, 35) -->
    <body name="Building_04" pos="-130 -100 35">
      <geom name="bldg04_geom" type="box" size="45 30 35" material="building_facade1"/>
      <geom name="bldg04_roof" type="box" pos="0 0 35.1" size="44 29 0.1" material="building_roof" contype="0" conaffinity="0"/>
    </body>

    <!-- Building_05: Pos (0, 180, 40), Size (60, 60, 80) -> half-extents (30, 30, 40) -->
    <body name="Building_05" pos="0 180 40">
      <geom name="bldg05_geom" type="box" size="30 30 40" material="building_facade2"/>
      <geom name="bldg05_roof" type="box" pos="0 0 40.1" size="29 29 0.1" material="building_roof" contype="0" conaffinity="0"/>
    </body>

    <!-- ==================== DRONE D01 (Primary controllable) ==================== -->
    <body name="D01" mocap="true" pos="0 0 5">
      <!-- Central Body -->
      <geom name="D01_body" type="cylinder" size="0.9 0.25" material="drone_chassis"/>
      <geom name="D01_dome" type="sphere" pos="0 0 0.15" size="0.45" material="drone_indicator"/>
      <!-- Cross Arms -->
      <geom name="D01_arm1" type="capsule" fromto="-1.5 -1.5 0 1.5 1.5 0" size="0.1" material="drone_arm"/>
      <geom name="D01_arm2" type="capsule" fromto="-1.5 1.5 0 1.5 -1.5 0" size="0.1" material="drone_arm"/>
      <!-- Rotors (Front = Orange/Red, Rear = Cyan) -->
      <geom name="D01_rotor_fl" type="cylinder" pos="1.5 1.5 0.1" size="0.65 0.03" material="rotor_front"/>
      <geom name="D01_rotor_fr" type="cylinder" pos="1.5 -1.5 0.1" size="0.65 0.03" material="rotor_front"/>
      <geom name="D01_rotor_bl" type="cylinder" pos="-1.5 1.5 0.1" size="0.65 0.03" material="rotor_rear"/>
      <geom name="D01_rotor_br" type="cylinder" pos="-1.5 -1.5 0.1" size="0.65 0.03" material="rotor_rear"/>
      <!-- 100m Communication Radius Sphere (visual only, non-colliding) -->
      <geom name="D01_comm_sphere" type="sphere" size="100.0" material="comm_sphere_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- ==================== DRONE D02 (Standby / Spawnable for testing) ==================== -->
    <body name="D02" mocap="true" pos="0 0 -100">
      <geom name="D02_body" type="cylinder" size="0.9 0.25" material="drone_chassis"/>
      <geom name="D02_dome" type="sphere" pos="0 0 0.15" size="0.45" rgba="0.9 0.6 0.1 1"/>
      <geom name="D02_arm1" type="capsule" fromto="-1.5 -1.5 0 1.5 1.5 0" size="0.1" material="drone_arm"/>
      <geom name="D02_arm2" type="capsule" fromto="-1.5 1.5 0 1.5 -1.5 0" size="0.1" material="drone_arm"/>
      <geom name="D02_rotor_fl" type="cylinder" pos="1.5 1.5 0.1" size="0.65 0.03" material="rotor_front"/>
      <geom name="D02_rotor_fr" type="cylinder" pos="1.5 -1.5 0.1" size="0.65 0.03" material="rotor_front"/>
      <geom name="D02_rotor_bl" type="cylinder" pos="-1.5 1.5 0.1" size="0.65 0.03" material="rotor_rear"/>
      <geom name="D02_rotor_br" type="cylinder" pos="-1.5 -1.5 0.1" size="0.65 0.03" material="rotor_rear"/>
      <geom name="D02_comm_sphere" type="sphere" size="100.0" material="comm_sphere_d2_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- ==================== DRONE D03 (Standby Drone 3) ==================== -->
    <body name="D03" mocap="true" pos="0 0 -100">
      <geom name="D03_body" type="cylinder" size="0.9 0.25" material="drone_chassis"/>
      <geom name="D03_dome" type="sphere" pos="0 0 0.15" size="0.45" rgba="0.8 0.2 0.8 1"/>
      <geom name="D03_arm1" type="capsule" fromto="-1.5 -1.5 0 1.5 1.5 0" size="0.1" material="drone_arm"/>
      <geom name="D03_arm2" type="capsule" fromto="-1.5 1.5 0 1.5 -1.5 0" size="0.1" material="drone_arm"/>
      <geom name="D03_rotor_fl" type="cylinder" pos="1.5 1.5 0.1" size="0.65 0.03" material="rotor_front"/>
      <geom name="D03_rotor_fr" type="cylinder" pos="1.5 -1.5 0.1" size="0.65 0.03" material="rotor_front"/>
      <geom name="D03_rotor_bl" type="cylinder" pos="-1.5 1.5 0.1" size="0.65 0.03" material="rotor_rear"/>
      <geom name="D03_rotor_br" type="cylinder" pos="-1.5 -1.5 0.1" size="0.65 0.03" material="rotor_rear"/>
      <geom name="D03_comm_sphere" type="sphere" size="100.0" rgba="0.8 0.2 0.8 0.08" contype="0" conaffinity="0"/>
    </body>

  </worldbody>
</mujoco>
